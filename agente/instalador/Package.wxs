<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- Instalador do Integrador IABS (docs/protocolo-canal.md e LEIAME.md). -->
  <Package Name="Integrador IABS"
           Manufacturer="IABS"
           Version="$(var.Versao)"
           UpgradeCode="6F1D2B7A-3C4E-4A9B-9E21-5B7C8D9E0A13"
           Scope="perMachine"
           Compressed="yes"
           Language="1046"
           Codepage="1252"
           InstallerVersion="500">

    <SummaryInformation Description="Integrador IABS: ponte entre a IABS e o banco do Senior, só com conexão de saída." />
    <!-- AllowSameVersionUpgrades: reinstalar a mesma versão por cima (2.1.0) -->
    <MajorUpgrade DowngradeErrorMessage="Uma versão mais nova do Integrador IABS já está instalada."
                  Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes" />

    <!-- Telas da instalação (2.1.0), em português: boas-vindas, licença de código
         visível, escolha da pasta e confirmação. Na atualização (inclusive a
         automática, sem telas), a pasta é a da instalação anterior, lida do
         registro antes de a versão antiga sair. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="Licenca.rtf" />
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PastaAnterior" Root="HKLM" Key="SOFTWARE\IABS\AgenteSenior" Name="PastaInstalacao" Type="raw" Bitness="always64" />
    </Property>
    <MediaTemplate EmbedCab="yes" />

    <!-- Requisitos da máquina: conferidos antes de instalar. Não há runtime a
         instalar: o .NET vai dentro da pasta do agente. -->
    <Property Id="WINBUILD">
      <RegistrySearch Id="BuscaBuildWindows" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR VersionNT64"
            Message="O Integrador IABS precisa de Windows 64 bits." />
    <Launch Condition="Installed OR (WINBUILD &gt;= 17763)"
            Message="O Integrador IABS precisa de Windows Server 2019 ou mais novo (ou Windows 10 versão 1809 ou mais nova)." />
    <Launch Condition="Privileged"
            Message="A instalação do Integrador IABS precisa de privilégio de administrador." />

    <!-- Painel de Controle: só "Desinstalar" (o ARPNOMODIFY vem das telas do WixUI) -->
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPCONTACT" Value="Suporte IABS" />
    <Property Id="ARPCOMMENTS" Value="Ponte entre a IABS e o banco do Senior: só conexão de saída e operações fixas." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="PastaIabs" Name="IABS">
        <Directory Id="INSTALLFOLDER" Name="AgenteSenior" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="StartupFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Principal" Title="Integrador IABS" Level="1">
      <ComponentGroupRef Id="Binarios" />
    </Feature>

    <ComponentGroup Id="Binarios" Directory="INSTALLFOLDER">
      <!-- runtime e bibliotecas, publicados em pasta (sem extração para a pasta temporária) -->
      <Files Include="$(var.Publicar)\**">
        <Exclude Files="$(var.Publicar)\IabsAgenteSenior.exe" />
        <Exclude Files="$(var.Publicar)\IabsAgenteSenior.Configurador.exe" />
        <Exclude Files="$(var.Publicar)\IabsAgenteSenior.Monitor.exe" />
      </Files>

      <!-- ícone perto do relógio: abre no login de cada usuário (pasta Inicializar de todos os usuários) -->
      <Component Id="Monitor">
        <File Id="ArquivoMonitor" Source="$(var.Publicar)\IabsAgenteSenior.Monitor.exe" KeyPath="yes" />
      </Component>
      <Component Id="AtalhoMonitor" Directory="StartupFolder">
        <Shortcut Id="AtalhoInicializar"
                  Name="Integrador IABS (status)"
                  Description="Mostra perto do relógio se o Integrador IABS está conectado."
                  Target="[#ArquivoMonitor]"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\IABS\AgenteSenior" Name="AtalhoMonitor" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- a janela de configuração e o atalho no menu Iniciar -->
      <Component Id="Configurador">
        <File Id="ArquivoConfigurador" Source="$(var.Publicar)\IabsAgenteSenior.Configurador.exe" KeyPath="yes" />
      </Component>
      <Component Id="AtalhoConfigurador" Directory="ProgramMenuFolder">
        <Shortcut Id="AtalhoMenuIniciar"
                  Name="Configurar Integrador IABS"
                  Description="Configura a conexão com a IABS e com o banco do Senior e mostra a situação do integrador."
                  Target="[#ArquivoConfigurador]"
                  WorkingDirectory="INSTALLFOLDER" />
        <!-- padrão do WiX para atalho: chave do usuário que instala como KeyPath (ICE57) -->
        <RegistryValue Root="HKCU" Key="Software\IABS\AgenteSenior" Name="AtalhoConfigurador" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <!-- atalho na Área de Trabalho (2.1.0): abre a mesma janela de configuração -->
      <Component Id="AtalhoAreaDeTrabalho" Directory="DesktopFolder">
        <Shortcut Id="AtalhoDesktop"
                  Name="Integrador IABS"
                  Description="Configura o Integrador IABS e mostra se ele está conectado à IABS."
                  Target="[#ArquivoConfigurador]"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\IABS\AgenteSenior" Name="AtalhoAreaDeTrabalho" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- o executável e o serviço do Windows -->
      <Component Id="ServicoAgente">
        <File Id="ArquivoExe" Source="$(var.Publicar)\IabsAgenteSenior.exe" KeyPath="yes" />
        <ServiceInstall Id="InstalarServico"
                        Name="IabsAgenteSenior"
                        DisplayName="Integrador IABS"
                        Description="Mantém o canal com a IABS e atende as operações fixas no banco do Senior."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="NT SERVICE\IabsAgenteSenior"
                        Vital="yes">
          <ServiceConfig DelayedAutoStart="yes" OnInstall="yes" OnReinstall="yes" />
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="60"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="ControlarServico" Name="IabsAgenteSenior" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <!-- O atualizador (2.1.0): o mesmo executável, com o argumento "atualizador",
             como SYSTEM e só com início manual. O integrador o liga quando a IABS
             pede uma versão nova (o PrepararInstalacao dá a ele só essa permissão);
             ele confere o SHA-256 (IABS, GitHub e arquivo), roda o msiexec e para. -->
        <ServiceInstall Id="InstalarAtualizador"
                        Name="IabsIntegradorAtualizador"
                        DisplayName="Integrador IABS (atualizador)"
                        Description="Instala a versão nova do Integrador IABS quando a IABS pede, só do repositório oficial e conferida pelo SHA-256. Não fica rodando."
                        Type="ownProcess"
                        Start="demand"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Arguments="atualizador"
                        Vital="yes" />
        <ServiceControl Id="ControlarAtualizador" Name="IabsIntegradorAtualizador" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>

      <Component Id="RegistroAgente">
        <RegistryValue Root="HKLM" Key="SOFTWARE\IABS\AgenteSenior" Name="Versao" Type="string" Value="$(var.Versao)" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\IABS\AgenteSenior" Name="PastaInstalacao" Type="string" Value="[INSTALLFOLDER]" />
      </Component>
    </ComponentGroup>

    <!-- Desinstalação de verdade (não atualização, sem MANTERDADOS=1): o próprio
         agente apaga C:\ProgramData\IABS\AgenteSenior (configuração, estado, fila,
         logs), depois do serviço parado. O que estiver preso fica para a reinicialização. -->
    <CustomAction Id="RemoverDados" FileRef="ArquivoExe" ExeCommand="remover-dados"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- Depois de instalar o serviço (26/11/2026): quem instala (UserSID) ganha
         acesso à pasta de dados e permissão de consultar, iniciar e parar o
         serviço. Assim a janela de configuração e o ícone abrem sem o controle
         de conta de usuário; os outros usuários da máquina continuam sem acesso. -->
    <CustomAction Id="PrepararInstalacao" FileRef="ArquivoExe" ExeCommand="preparar-instalacao --usuario [UserSID]"
                  Execute="deferred" Impersonate="no" Return="check" />
    <!-- Antes de atualizar ou desinstalar, fecha o ícone e a janela de configuração
         em todas as sessões (manda fechar; se não fechar, encerra), para nenhum
         arquivo ficar preso. -->
    <util:CloseApplication Id="FecharMonitor" Target="IabsAgenteSenior.Monitor.exe"
                           CloseMessage="yes" TerminateProcess="0" RebootPrompt="no" />
    <util:CloseApplication Id="FecharConfigurador" Target="IabsAgenteSenior.Configurador.exe"
                           CloseMessage="yes" TerminateProcess="0" RebootPrompt="no" />

    <!-- Abre a janela de configuração no fim da instalação interativa, também na
         atualização (não na silenciosa). A janela abre como o usuário, sem pedir
         administrador: a permissão veio do PrepararInstalacao. -->
    <Property Id="WixShellExecTarget" Value="[#ArquivoConfigurador]" />
    <CustomAction Id="AbrirConfigurador" DllEntry="WixShellExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Impersonate="yes" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RemoverDados" After="StopServices"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT MANTERDADOS" />
      <Custom Action="PrepararInstalacao" After="InstallServices" Condition="NOT (REMOVE=&quot;ALL&quot;)" />
      <Custom Action="AbrirConfigurador" After="InstallFinalize"
              Condition="NOT Installed AND UILevel &gt;= 3" />
    </InstallExecuteSequence>

  </Package>
</Wix>
